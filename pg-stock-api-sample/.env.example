# pg-stock(PostgreSQL) 접속. Docker 컨테이너 안에서는 pg-stock:5432, 호스트에서는 매핑 포트를 쓴다.
OHLCV_DATABASE_URL=postgresql+psycopg://admin:admin1234@localhost:55432/admin

# 기동 시 APScheduler 등록 여부
SCHEDULER_ENABLED=true

# OHLCV 증분 수집 배치
OHLCV_SYNC_ENABLED=true
OHLCV_SYNC_TICKERS=listed         # listed(KOSPI·KOSDAQ 주식 전체, ETF·ETN·리츠·펀드 제외) | major | all | 005930,000660
OHLCV_SYNC_PROVIDER=naver         # naver | yahoo | auto
OHLCV_SYNC_START_YEAR=2016         # 이 해 1월 1일부터 (약 10년치)
OHLCV_SYNC_CORRECTION_DAYS=7
OHLCV_SYNC_HOURS=9,12,16          # Asia/Seoul
OHLCV_SYNC_MINUTE=50
OHLCV_SYNC_MAX_TICKERS=0          # listed/all 일 때 상한(0=무제한)
OHLCV_SYNC_REQUEST_DELAY=0.05     # 공급자 요청 사이 대기(초)

# POST /openapi/v1/ohlcv/ingest 에 쓰는 Bearer 키(쉼표로 여러 개)
OHLCV_API_KEYS=change-me

# 1분봉 (KIS 주식일별분봉조회 — 과거 약 1년 보관). 실전 앱키 필요 (모의투자 키는 초당 2건)
KIS_APP_KEY=
KIS_APP_SECRET=
MINUTE_SYNC_ENABLED=false         # true: 평일 17:30(한국시간)에 최근 10거래일 중 빠진 1분봉 채우기
MINUTE_SYNC_HOUR=17
MINUTE_SYNC_MINUTE=30
MINUTE_CATCHUP_DAYS=10
MINUTE_REQUESTS_PER_SECOND=15     # KIS 실전 한도 초당 20건보다 낮게
MINUTE_WORKERS=2
