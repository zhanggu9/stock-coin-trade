# AWS Lambda가 이 저장소의 EC2 Docker DB에 직접 접속할 때 sam-deploy.sh가 읽는 파일입니다.
# 사용: cp working/env/lambda.env.example working/env/lambda.env
# lambda.env는 비밀번호를 포함하므로 커밋하지 않습니다.
#
# 중요
# - sam local: working/env/local-env.json의 Docker 서비스명(mariadb/postgres/redis/qdrant)을 사용합니다.
# - AWS Lambda: Docker 서비스명을 해석할 수 없으므로 EC2 private IP 또는 private DNS를 사용합니다.
# - URL의 사용자명/비밀번호에 @ : / # 등이 있으면 URL 인코딩해야 합니다.

# EC2 Docker 컨테이너에 연결할 직접 URL
LAMBDA_MEMBER_DATABASE_URL='mysql+pymysql://mockinv:CHANGE_ME@10.0.0.10:3306/mockinv'
LAMBDA_QUANT_DATABASE_URL='postgresql+psycopg://quant:CHANGE_ME@10.0.0.10:5432/quant_research'
LAMBDA_OHLCV_DATABASE_URL='postgresql+psycopg://admin:CHANGE_ME@10.0.0.10:55432/admin'
LAMBDA_OHLCV_CREATE_ALB='false'
LAMBDA_OHLCV_CERTIFICATE_ARN=''
LAMBDA_REDIS_URL='redis://10.0.0.10:6379/0'
LAMBDA_QDRANT_URL='http://10.0.0.10:6333'
LAMBDA_QDRANT_API_KEY=''

# Lambda를 EC2와 같은 VPC에 연결하는 값. ARN이 아니라 실제 SG/subnet ID입니다.
# OHLCV 템플릿은 자체 Lambda SG를 만들므로 VPC_ID가 필요합니다.
# 다른 타깃은 VPC_SECURITY_GROUP_IDS를 사용합니다.
# EC2 보안 그룹은 필요한 DB/서비스 포트만 Lambda SG에서 허용해야 합니다.
VPC_ID='vpc-EXAMPLE'
VPC_SECURITY_GROUP_IDS='sg-0123456789abcdef0'
VPC_SUBNET_IDS='subnet-0123456789abcdef0,subnet-0fedcba9876543210'

# member/session HTTP API 인증. 해당 타깃을 배포할 때만 필요합니다.
JWT_ISSUER='https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_EXAMPLE'
JWT_AUDIENCE='example-client-id'
