# sam deploy --guided에 전달할 Secrets Manager ARN 예시입니다.
# 각 secret은 아래 주석의 JSON 키를 가져야 하며 실제 URL·비밀번호를 이 파일에 적지 않습니다.

# member secret JSON: {"DATABASE_URL":"mysql+pymysql://..."}
MEMBER_DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:member-db

# quant secret JSON: {"QUANT_DATABASE_URL":"postgresql+psycopg://..."}
QUANT_DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:quant-db

# ohlcv secret JSON: {"OHLCV_DATABASE_URL":"postgresql+psycopg://..."}
OHLCV_DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:ohlcv-db

# session secret JSON: {"REDIS_URL":"rediss://..."}
REDIS_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:redis-session

# knowledge secret JSON: {"QDRANT_URL":"https://...","QDRANT_API_KEY":"..."}
QDRANT_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:qdrant

# member/session JWT authorizer와 Lambda VPC 파라미터 예시
JWT_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_EXAMPLE
JWT_AUDIENCE=example-client-id
VPC_SECURITY_GROUP_IDS=sg-0123456789abcdef0
VPC_SUBNET_IDS=subnet-0123456789abcdef0,subnet-0fedcba9876543210
